Make bundled emulator demo assets optional

Retain the upstream package by default. The AOSStudio source pilot uses the generic AVD hardware and disables the optional vendor resources.

--- a/CMakeLists.txt
+++ b/CMakeLists.txt
@@ -116,6 +116,8 @@
       BOOL
       "Minimum set of components to support 64-bit guets only."
 )
+option(OPTION_BUNDLE_DEMO_ASSETS
+       "Bundle virtual scenes, automation demos, and device skins." ON)
 set(OPTION_TCMALLOC
     TRUE
     CACHE
--- a/android/android-emu/android-emu.cmake
+++ b/android/android-emu/android-emu.cmake
@@ -781,11 +781,13 @@
       testdata/ver/poster_test.obj
       testdata/ver/poster_test.posters)
 
-  prebuilt(VIRTUALSCENE)
   android_copy_test_files(android-emu_unittests "${android-emu-testdata}"
                           testdata)
-  android_target_dependency(android-emu_unittests all
-                            VIRTUAL_SCENE_DEPENDENCIES)
+  if(OPTION_BUNDLE_DEMO_ASSETS)
+    prebuilt(VIRTUALSCENE)
+    android_target_dependency(android-emu_unittests all
+                              VIRTUAL_SCENE_DEPENDENCIES)
+  endif()
   android_copy_test_dir(android-emu_unittests test-sdk test-sdk)
 
   # Declare virtual_environment_renderer_unittests
